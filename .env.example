# ============================================================================
# ImpactoCidadão — copie este arquivo para ".env" (na raiz do projeto) e ajuste.
# NUNCA publique o .env: ele contém chaves secretas. (já está no .gitignore)
# ============================================================================

# --- Banco de dados ---------------------------------------------------------
# Local (docker compose up -d):
DATABASE_URL=postgresql://impacto:impacto@127.0.0.1:5432/impacto
# Supabase: Project Settings > Database > Connection string (use a do "pooler"):
# DATABASE_URL=postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?sslmode=require

# --- IA ---------------------------------------------------------------------
# "anthropic" (Claude) ou "gemini"
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# Padrão: o modelo mais capaz da família Opus. Para reduzir custo em volume, teste "claude-sonnet-5-5".
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (profundidade de raciocínio)
ANTHROPIC_EFFORT=medium
# Se o classificador de segurança recusar um pedido, reexecuta em outro modelo no servidor.
# Ponha "false" caso a API devolva erro 400 mencionando "fallback".
ANTHROPIC_FALLBACK=true

GEMINI_API_KEY=
# Ajuste para o modelo Gemini vigente na sua conta.
GEMINI_MODEL=gemini-2.5-flash

# --- Coleta -----------------------------------------------------------------
# E-mail de contato opcional: vai no User-Agent das requisições às APIs públicas.
CONTATO_EMAIL=
# Eleição Geral Federal 2026 (ver https://divulgacandcontas.tse.jus.br/divulga/rest/v1/eleicao/ordinarias)
TSE_ANO=2026
TSE_ELEICAO_ID=20322002026
# Limites de texto enviado à IA (em caracteres). Acima disso a análise é adiada, nunca truncada.
MAX_CHARS_TEXTO=400000
MAX_CHARS_PLANO=1500000

# --- API --------------------------------------------------------------------
# Sal usado para anonimizar tokens de voto. Troque por um valor aleatório longo.
VOTO_SAL=troque-este-sal-em-producao
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
